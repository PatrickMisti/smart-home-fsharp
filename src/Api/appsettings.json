{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Persistence": {
    // LinqToDB-Provider: "SQLite.MS" (Microsoft.Data.Sqlite) oder "PostgreSQL" (Npgsql)
    "Provider": "SQLite.MS",
    "ConnectionString": "Data Source=smarthome.db"
    // Postgres-Beispiel:
    // "Provider": "PostgreSQL",
    // "ConnectionString": "Host=localhost;Port=5432;Database=smarthome;Username=smarthome;Password=smarthome"
  }
}
