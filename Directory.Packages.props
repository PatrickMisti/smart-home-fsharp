<Project>

  <!-- Central Package Management: Versionen nur hier pflegen,
       in den .fsproj-Dateien nur <PackageReference Include="..." /> ohne Version -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- F# Core: zentral gepinnt, damit alle Projekte dieselbe Version nutzen.
       Bleibt auf 10.1.x, weil Fable.Remoting FSharp.Core < 10.2 verlangt. -->
  <ItemGroup>
    <PackageVersion Include="FSharp.Core" Version="10.1.404" />
  </ItemGroup>

  <!-- Aktoren / Event Sourcing -->
  <ItemGroup>
    <PackageVersion Include="Akka" Version="1.5.75" />
    <PackageVersion Include="Akka.Hosting" Version="1.5.75" />
    <PackageVersion Include="Akka.Persistence" Version="1.5.75" />
    <PackageVersion Include="Akka.Persistence.Sql" Version="1.5.73" />
    <PackageVersion Include="Akka.Persistence.Sql.Hosting" Version="1.5.73" />
  </ItemGroup>

  <!-- Messaging -->
  <ItemGroup>
    <PackageVersion Include="MQTTnet" Version="5.2.0.1603" />
  </ItemGroup>

  <!-- Web / API -->
  <ItemGroup>
    <PackageVersion Include="Giraffe" Version="8.3.0" />
    <PackageVersion Include="Fable.Remoting.Giraffe" Version="6.1.0" />
  </ItemGroup>

  <!-- UI (Fable / Elmish) -->
  <ItemGroup>
    <PackageVersion Include="Fable.Core" Version="5.6.1" />
    <PackageVersion Include="Fable.Browser.Dom" Version="2.20.0" />
    <PackageVersion Include="Fable.Elmish" Version="5.0.2" />
    <PackageVersion Include="Fable.Elmish.React" Version="5.6.0" />
    <PackageVersion Include="Fable.Elmish.HMR" Version="9.0.0" />
    <PackageVersion Include="Feliz" Version="3.4.0" />
    <PackageVersion Include="Fable.Remoting.Client" Version="8.0.0" />
  </ItemGroup>

  <!-- Transitive Sicherheits-Pins (Fable.Remoting.Server zieht sonst WebUtilities 2.3.0, GHSA-6527-9fp8-r4x6) -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.WebUtilities" Version="11.0.0" />
  </ItemGroup>

  <!-- Datenbanken -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <PackageVersion Include="Npgsql" Version="11.0.0" />
  </ItemGroup>

  <!-- Tests -->
  <ItemGroup>
    <PackageVersion Include="coverlet.collector" Version="10.1.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

</Project>
